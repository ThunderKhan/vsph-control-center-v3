# API-only local development. Copy to backend/.env (ignored by Git).
NODE_ENV=development
API_PORT=4000
PUBLIC_ORIGIN=http://localhost:3000

# Staging ONLY after a reviewed, separately restored database:
# SUPABASE_URL=https://your-staging-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-staging-publishable-key
# DATABASE_URL=postgresql://isolated_role:...@staging-host:5432/staging
